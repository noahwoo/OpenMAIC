:host {
  display: block;
}
.frame {
  width: 100%;
  height: calc((100vw - 64rpx) * 0.5625);
  overflow: hidden;
  background: #fff;
  border-radius: 24rpx;
  border: 1rpx solid #e3e9f2;
}
.viewport {
  width: 100%;
  height: 100%;
}
.canvas {
  width: 1000px;
  height: 562.5px;
  transform-origin: top left;
  position: relative;
  overflow: hidden;
}
.element {
  position: absolute;
  box-sizing: border-box;
  overflow: hidden;
}
.text {
  font-size: 24px;
  line-height: 1.45;
}
.shape {
  border-radius: 8px;
}
.line {
  border-top: 2px solid #65748c;
}
.fallback {
  font-size: 22px;
  color: #65748c;
  border: 1px dashed #c6cfdd;
}
.hint {
  font-size: 22rpx;
  color: #7d89a0;
  margin: 0 0 16rpx;
}
