<view class="page classroom"><view wx:if="{{loading}}" class="empty">正在准备课堂…</view><view wx:if="{{error}}" class="error">{{error}}<button class="secondary" bindtap="load">重新加载</button></view>
<view wx:if="{{!loading && !error && !scenes.length}}" class="empty">这门课程尚未生成内容。<button class="secondary" bindtap="load">刷新课程</button></view><block wx:if="{{scene}}"><view class="eyebrow">{{title}}</view><view class="row"><view class="title scene-title">{{scene.title}}</view><text class="tag">{{index + 1}} / {{scenes.length}}</text></view>
<scroll-view scroll-x class="scene-tabs"><view class="scene-strip"><view wx:for="{{scenes}}" wx:for-index="sceneIndex" wx:key="id" class="pill {{index === sceneIndex ? 'active' : ''}}" data-index="{{sceneIndex}}" bindtap="select">{{sceneIndex + 1}} · {{item.title}}</view></view></scroll-view>
<slide-view wx:if="{{scene.type === 'slide'}}" scene="{{scene}}"/>
<view wx:if="{{scene.interactiveActivity || scene.hasWhiteboard}}" class="card"><view class="card-title">{{scene.type === 'pbl' ? '项目实训' : scene.type === 'interactive' ? '原生交互模拟' : '动态白板课堂'}}</view><view class="muted">使用原生竖屏组件调节实验参数、开展任务对话与提交评阅，并逐步播放白板绘制。</view><button class="primary" style="margin-top:20rpx" bindtap="openActivity">进入互动课堂</button></view>
<view wx:if="{{scene.unsupported}}" class="card"><view class="card-title">这节课包含复杂交互</view><view class="muted">小程序可阅读教师讲解并收听已生成语音。当前场景类型暂未提供专用交互。</view><button class="secondary" style="margin-top:20rpx" bindtap="copyDesktop">复制完整版课程链接</button></view>
<view class="row modes"><view class="pill {{tab === 'notes' ? 'active' : ''}}" data-tab="notes" bindtap="tab">讲义</view><view class="pill {{tab === 'audio' ? 'active' : ''}}" data-tab="audio" bindtap="tab">听讲 · {{scene.speeches.length}}</view><view wx:if="{{scene.type === 'quiz'}}" class="pill {{tab === 'quiz' ? 'active' : ''}}" data-tab="quiz" bindtap="tab">测验</view></view>
<block wx:if="{{tab === 'notes'}}"><view wx:for="{{scene.notes}}" wx:key="id" class="card body">{{item.text}}</view><view wx:if="{{!scene.notes.length}}" class="card muted">本页没有独立文字讲义，可切换「听讲」查看教师讲解。</view><view class="muted small">基础课件使用原生元素预览。复杂图表、公式与动画以网页版呈现为准。</view></block>
<block wx:if="{{tab === 'audio'}}"><view wx:for="{{scene.speeches}}" wx:key="id" class="card speech {{clip === index ? 'current' : ''}}" data-index="{{index}}" bindtap="chooseClip"><text class="tag">讲解 {{index + 1}}{{clip === index ? ' · 当前' : ''}}</text><view class="body" style="margin-top:20rpx">{{item.text}}</view><view wx:if="{{!item.audioId}}" class="muted">当前段落暂无已生成语音</view></view><view wx:if="{{!scene.speeches.length}}" class="empty">本节暂无教师讲解。</view></block>
<block wx:if="{{tab === 'quiz'}}"><view wx:if="{{submitted}}" class="hero" style="margin-bottom:24rpx"><view>测验反馈</view><view class="count">{{score}} / {{total}}</view><view class="muted">仅统计有参考答案的选择题 · 答案保存在本设备</view><button class="secondary" bindtap="resetQuiz" style="margin-top:20rpx">再试一次</button></view><view wx:for="{{questions}}" wx:key="id" wx:for-item="question" class="card"><view class="tag">{{question.type === 'multiple' ? '多选题' : question.type === 'single' ? '单选题' : '简答题'}}</view><view class="card-title">{{question.question}}</view><textarea wx:if="{{question.type === 'short_answer'}}" class="field" placeholder="写下你的思考" maxlength="5000" disabled="{{submitted}}" data-id="{{question.id}}" value="{{question.selected[0] || ''}}" bindinput="shortAnswer"/><view wx:for="{{question.options}}" wx:key="value" wx:for-item="option" class="option {{option.checked ? 'selected' : ''}}" data-qid="{{question.id}}" data-value="{{option.value}}" bindtap="chooseAnswer"><text class="tag">{{option.value}}</text><text>{{option.label}}</text></view><view wx:if="{{submitted}}" class="{{question.correct === false ? 'wrong' : 'correct'}}">{{question.feedback}}<view class="body">{{question.analysisText}}</view></view></view><button wx:if="{{!submitted}}" class="primary" bindtap="grade">提交测验</button><view class="muted small" style="margin-top:20rpx">当前版本在设备本地记录练习答案，不回写服务端学习记录；简答题不自动判分。</view></block>
<view class="bottom"><view wx:if="{{scene.speeches.length}}" class="row audio-bar"><text class="muted">讲解 {{clip + 1}} / {{scene.speeches.length}}</text><button class="secondary" bindtap="togglePlay" loading="{{downloading}}">{{playing || downloading ? '停止听讲' : '▶ 听老师讲'}}</button></view><view class="row"><button class="quiet grow" disabled="{{index === 0}}" bindtap="previous">← 上一节</button><button class="primary grow" disabled="{{index + 1 === scenes.length}}" bindtap="next">下一节 →</button></view></view></block></view>
