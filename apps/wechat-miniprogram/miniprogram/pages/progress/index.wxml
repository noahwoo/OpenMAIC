<view class="page"><view class="eyebrow">AI 正在备课</view><view class="title">{{run.label || '读取进度…'}}</view><view class="subtitle">{{run.title}}</view>
<view wx:if="{{error}}" class="error">{{error}}<button class="quiet" bindtap="refresh">重新连接</button></view>
<view wx:if="{{run}}" class="card" style="margin-top:32rpx"><view class="row"><text class="count">{{run.percent}}<text class="muted">%</text></text><text class="tag">{{run.done}} / {{run.total || '—'}} 节</text></view><view class="progress-track"><view class="progress-fill" style="width:{{run.percent}}%"></view></view><view class="muted">{{run.detail}}</view></view>
<view wx:if="{{run.errorMessage}}" class="error">{{run.errorMessage}}</view>
<view wx:if="{{run.outlines.length}}" class="section">课程安排</view><view wx:for="{{run.outlines}}" wx:key="id" class="card"><text class="tag">第 {{index + 1}} 节 · {{item.type}}</text><view class="card-title">{{item.title}}</view><view class="muted">{{item.description}}</view></view>
<view class="muted">后台任务会继续运行。生成时间取决于模型与语音服务，退出页面不会中断任务。</view>
<view class="bottom stack"><button wx:if="{{run.state === 'awaiting_outline_confirmation'}}" class="primary" bindtap="command" data-kind="confirm-outline" loading="{{busy}}" disabled="{{busy}}">确认大纲，继续生成</button><button wx:elif="{{run.state === 'paused'}}" class="primary" bindtap="command" data-kind="retry" loading="{{busy}}" disabled="{{busy}}">从失败步骤重试</button><button wx:if="{{run.stageId}}" class="{{run.state === 'completed' ? 'primary' : 'secondary'}}" bindtap="open">{{run.state === 'completed' ? '进入课堂 →' : '先看已完成的内容 →'}}</button><button class="quiet" bindtap="home">返回学习空间</button></view></view>
